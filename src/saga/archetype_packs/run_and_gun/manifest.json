    {
      "id": "hud.run_and_gun",
      "version": 1,
      "implementation": "stable_pack",
      "requires": [
        {"id": "combat.ranged_arsenal", "version": 1},
        {"id": "world.run_and_gun", "version": 1},
        {"id": "boss.run_and_gun", "version": 1},
        {"id": "progression.run_and_gun", "version": 1}
