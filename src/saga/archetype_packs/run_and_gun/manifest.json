      "state_owners": ["boss.run_and_gun"],
      "runtime_files": ["boss.gd", "run_and_gun_level.gd"],
      "required_probes": ["objective.boss_damage_verified", "objective.boss_phases_verified", "objective.boss_win_verified"]
