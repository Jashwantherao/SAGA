# Hosted backend for the Game Designer and/or Coder (OpenAI-compatible).
# Enable per agent with SAGA_DESIGNER_BACKEND=deepseek / SAGA_CODER_BACKEND=deepseek.
# Roughly $0.003 for a 4-level game; leave unset to run fully local via Ollama.
DEEPSEEK_API_KEY=your-deepseek-key-here

# Only needed for SAGA_DESIGNER_BACKEND=claude.
ANTHROPIC_API_KEY=your-api-key-here

# Hosted vision model for QA's screenshot review. Set SAGA_VISION_BACKEND=nvidia
# to use it; the default stays local (Ollama) so an offline clone still works.
# A hosted VLM reliably spots placeholder art that the local 12B misses, which
# is what surfaces missing sprites. Free-tier endpoints are flaky - the review
# degrades to "no findings" rather than failing a build, and never gates more
# than once per level.
NVIDIA_API_KEY=your-nvidia-key-here

# Required gameplay-video gate. Godot records an 8-second deterministic clip,
# FFmpeg converts it to MP4, and NVIDIA Nemotron checks motion, animation,
# facing direction, HUD readability, and temporal visual defects.
# SAGA_VIDEO_QA=1
# SAGA_VIDEO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# SAGA_VIDEO_BASE_URL=https://integrate.api.nvidia.com/v1
# SAGA_VIDEO_KEY_ENV=NVIDIA_API_KEY
# SAGA_VIDEO_TIMEOUT=120
# SAGA_VIDEO_REVIEW_ATTEMPTS=2
# SAGA_FFMPEG_EXE=ffmpeg

# Agent backends and models. Uncomment only the overrides you need.
# SAGA_DESIGNER_BACKEND=local
# SAGA_DESIGNER_MODEL=hf.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q3_K_S
# SAGA_DESIGNER_TIMEOUT=180
# SAGA_DIRECTOR_BACKEND=local
# Use deterministic for reproducible Coder benchmarks or fully offline triage.
# SAGA_DIRECTOR_BACKEND=deterministic
# SAGA_CODER_BACKEND=ollama
# SAGA_CODER_MODEL=qwen2.5-coder:14b
# SAGA_CODER_TIMEOUT=300
# Systems Architect: Nemotron owns whole-game structure by default. If its
# endpoint is unavailable the pipeline records the error and uses a safe,
# deterministic blueprint instead of blocking the production.
# SAGA_ARCHITECT_BACKEND=nvidia
# SAGA_ARCHITECT_MODEL=nvidia/nemotron-3-super-120b-a12b
# SAGA_ARCHITECT_BASE_URL=https://integrate.api.nvidia.com/v1
# SAGA_ARCHITECT_KEY_ENV=NVIDIA_API_KEY
# SAGA_ARCHITECT_TIMEOUT=180
# Quality mode: after the first complete draft, refine blueprint systems one
# at a time. Every candidate is transactionally compiled AND must still
# complete the mechanic's objective probe before promotion, so a pass that
# breaks the game is rolled back immediately. This adds one coder call plus
# one Godot gate and one probe run per system, so it is opt-in until
# benchmarks/incremental_ab.json shows the quality is worth the time.
# A system rejected by its routed model escalates to the plan's fallback
# models, each shown why its predecessors were rejected. 1 disables retries.
# SAGA_INCREMENTAL_BUILD=1
# SAGA_INCREMENTAL_MAX_SYSTEMS=6
# SAGA_INCREMENTAL_MAX_ATTEMPTS=2
# Verified Experience Memory retrieves one compact, first-pass, meaningfully
# similar same-mechanic script from datasets/coder_corpus.jsonl. Every eligible
# record passed Godot runtime and deterministic objective QA. Keep opt-in until
# broader repeated A/Bs prove it helps your selected Coder model.
# SAGA_EXPERIENCE_MEMORY=1
# SAGA_EXPERIENCE_MEMORY_LIMIT=1
# SAGA_EXPERIENCE_MEMORY_MAX_CHARS=12000
# SAGA_VISION_BACKEND=local
# SAGA_VISION_MODEL=gemma4:12b
# SAGA_FEEDBACK_BACKEND=local
# SAGA_FEEDBACK_MODEL=qwen2.5-coder:14b

# Local services and tools.
# SAGA_OLLAMA_URL=http://127.0.0.1:11434
# SAGA_COMFYUI_URL=http://127.0.0.1:8188
# SAGA_MUSICGEN_URL=http://127.0.0.1:8189
# SAGA_OUTPUT_ROOT=D:\SAGA\output
# SAGA_GODOT_EXE=D:\Godot\Godot_v4.7-stable_win64_console.exe

# Optional D:-drive launch paths used by the Studio's Services screen.
# SAGA_OLLAMA_EXE=D:\Ollama\ollama.exe
# SAGA_COMFYUI_DIR=D:\ComfyUI\ComfyUI
# SAGA_COMFYUI_PYTHON=D:\ComfyUI\.venv\Scripts\python.exe
# SAGA_MUSICGEN_DIR=D:\AudioCraft
# SAGA_MUSICGEN_PYTHON=D:\AudioCraft\.venv\Scripts\python.exe
# SAGA_MUSICGEN_SCRIPT=D:\AudioCraft\musicgen_server.py
# SAGA_OLLAMA_MODELS=D:\ollama\models
